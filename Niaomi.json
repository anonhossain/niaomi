      "id": "931f70ca-ce27-413b-a941-dfe84d99b4ce",
      "name": "Get Scene Data",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        448,
        160
      ],
      "executeOnce": true,
