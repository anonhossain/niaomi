    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const src = $('Set Status Working').item.json;\nconst prompt = (src.Prompt === undefined || src.Prompt === null) ? '' : src.Prompt.toString();\nconst topic = (src.Topic === undefined || src.Topic === null) ? '' : src.Topic.toString();\nconst generate = (src.Generate === undefined || src.Generate === null) ? '' : src.Generate.toString();\nconst genType = generate.trim().toLowerCase() === 'image' ? 'image' : 'video';\n// Extract @references; the char before @ must not be a word char, @ or dot so\n// email addresses (e.g. name@domain) and @@ are not treated as references.\nconst re = /(^|[^A-Za-z0-9_@.])@([A-Za-z0-9_]+)/g;\nconst refs = [];\nconst seen = {};\nlet m;\nwhile ((m = re.exec(prompt)) !== null) {\n  const token = m[2];\n  const key = token.toLowerCase();\n  if (!seen[key]) { seen[key] = true; refs.push(token); }\n}\nreturn { json: { original_prompt: prompt, topic: topic, generation_type: genType, references: refs } };"
      },
