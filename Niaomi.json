    {
      "parameters": {
        "jsCode": "const detItems = $('Detect @References').all();\nconst charRows = $('Get Character Data').all().map(i => i.json);\nconst sceneRows = $('Get Scene Data').all().map(i => i.json);\nconst norm = (v) => (v === undefined || v === null) ? '' : v.toString().trim().toLowerCase();\nconst out = [];\nfor (let idx = 0; idx < detItems.length; idx++) {\n  const det = detItems[idx].json;\n  const refs = det.references || [];\n  const topic = det.topic || '';\n  const characters = [];\n  const scenes = [];\n  const unresolved = [];\n  for (const ref of refs) {\n    const r = norm(ref);\n    const c = charRows.find(row => norm(row['Character ID']) === r || norm(row['Naam / rol']) === r);\n    if (c) {\n      characters.push({\n        character_id: c['Character ID'] || '',\n        name: c['Naam / rol'] || '',\n        fixed_description: c['Vaste beschrijving (in elke prompt)'] || '',\n        character_sheet_prompt: c['Character sheet prompt (front/profiel/achterkant + face close-up)'] || '',\n        notes: c['Notities'] || '',\n        reference: '@' + ref,\n      });\n      continue;\n    }\n    const s = sceneRows.find(row => norm(row['Scene ID']) === r || norm(row['Locatienaam']) === r);\n    if (s) {\n      scenes.push({\n        scene_id: s['Scene ID'] || '',\n        location_name: s['Locatienaam'] || '',\n        fixed_description: s['Vaste beschrijving (in elke prompt)'] || '',\n        reference_prompt: s['Reference / establishing prompt'] || '',\n        notes: s['Notities'] || '',\n        reference: '@' + ref,\n        selected_by: 'explicit',\n      });\n      continue;\n    }\n    unresolved.push({ reference: '@' + ref, status: 'not_found' });\n  }\n  // Topic-based scene selection ONLY when no explicit scene was referenced\n  // and the Scene sheet actually has a Topic column (forward-compatible).\n  if (scenes.length === 0 && topic.trim() !== '' && sceneRows.length > 0) {\n    const topicKey = Object.keys(sceneRows[0]).find(k => k.toLowerCase() === 'topic');\n    if (topicKey) {\n      const t = norm(topic);\n      for (const s of sceneRows) {\n        if (norm(s[topicKey]) === t) {\n          scenes.push({\n            scene_id: s['Scene ID'] || '',\n            location_name: s['Locatienaam'] || '',\n            fixed_description: s['Vaste beschrijving (in elke prompt)'] || '',\n            reference_prompt: s['Reference / establishing prompt'] || '',\n            notes: s['Notities'] || '',\n            reference: 'topic:' + topic,\n            selected_by: 'topic',\n          });\n        }\n      }\n    }\n  }\n  const context = {\n    original_prompt: det.original_prompt || '',\n    topic: topic,\n    generation_type: det.generation_type || 'image',\n    characters: characters,\n    scenes: scenes,\n    unresolved_references: unresolved,\n  };\n  out.push({ json: { context: context, context_json: JSON.stringify(context, null, 2) }, pairedItem: idx });\n}\nreturn out;"
      },
      "id": "cd893e23-7907-43dc-8d50-5e70cdb0c281",
      "name": "Build Context",
