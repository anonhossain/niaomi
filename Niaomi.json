    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const item = $json;\nlet raw = '';\nif (item.merged_response) { raw = item.merged_response; }\nelse if (Array.isArray(item.content)) { const t = item.content.find(c => c.type === 'text'); raw = t ? t.text : ''; }\nelse if (typeof item.content === 'string') { raw = item.content; }\nraw = (raw || '').toString().trim();\nraw = raw.replace(/^\\u0060\\u0060\\u0060json/i, '').replace(/^\\u0060\\u0060\\u0060/, '').replace(/\\u0060\\u0060\\u0060$/, '').trim();\nlet parsed = {};\nlet parseError = false;\ntry {\n  parsed = JSON.parse(raw);\n} catch (e) {\n  parseError = true;\n  // Salvage: pull individual string fields from a truncated/malformed JSON body.\n  const grab = (key) => {\n    const re = new RegExp('\"' + key + '\"\\\\s*:\\\\s*\"((?:[^\"\\\\\\\\]|\\\\\\\\.)*)\"');\n    const mm = raw.match(re);\n    return mm ? mm[1].replace(/\\\\\"/g, '\"').replace(/\\\\n/g, '\\n') : '';\n  };\n  parsed = {\n    generation_type: grab('generation_type'),\n    topic: grab('topic'),\n    original_prompt: grab('original_prompt'),\n    final_prompt: grab('final_prompt'),\n    negative_prompt: grab('negative_prompt'),\n    aspect_ratio: grab('aspect_ratio'),\n  };\n}\nconst ctx = $('Build Context').item.json.context || {};\nconst finalPrompt = parsed.final_prompt || '';\nconst img = parsed.image || {};\nconst vid = parsed.video || {};\nconst imagePrompt = img.prompt || finalPrompt || ctx.original_prompt || '';\nconst videoPrompt = vid.prompt || finalPrompt || ctx.original_prompt || '';\nreturn { json: {\n  structured: parsed,\n  original_prompt: ctx.original_prompt || parsed.original_prompt || '',\n  generation_type: ctx.generation_type || parsed.generation_type || 'image',\n  final_prompt: finalPrompt,\n  image_prompt: imagePrompt,\n  video_prompt: videoPrompt,\n  negative_prompt: parsed.negative_prompt || img.negative_prompt || vid.negative_prompt || '',\n  aspect_ratio: parsed.aspect_ratio || img.aspect_ratio || vid.aspect_ratio || '16:9',\n  unresolved_references: ctx.unresolved_references || [],\n  parse_error: parseError,\n} };"
      },
