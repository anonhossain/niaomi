      ]
    },
    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "claude-opus-5",
          "cachedResultName": "claude-opus-5"
        },
        "messages": {
          "values": [
            {
              "content": "=Build the final production-ready generation prompt from the CONTEXT below. Return VALID JSON ONLY.\n\nCONTEXT:\n{{ $json.context_json }}"
            }
          ]
        },
        "options": {
          "includeMergedResponse": true,
          "system": "You are a prompt engineer for text-to-image and text-to-video generation models.\nYou receive a JSON CONTEXT object containing: original_prompt, topic, generation_type, characters[], scenes[], unresolved_references[].\n\nAUTHORITATIVE DATA RULES:\n- The character and scene descriptions in CONTEXT come from a database and are AUTHORITATIVE. Never invent, alter or contradict them.\n- Preserve character fixed identity: face, hair, age, body, and clothing when specified in fixed_description.\n- Preserve scene fixed identity: location, architecture, environment, geographic/cultural traits, fixed visual elements.\n- NEVER invent character identity/appearance/IDs or scene identity/appearance/IDs. Only use what CONTEXT provides.\n- If unresolved_references is non-empty, do NOT fabricate those entities. Work with what exists and note that no predefined data was found for them.\n- If no scene exists at all, do not invent one.\n\nPRIORITY (highest first): 1) explicit user instruction in original_prompt (action, camera, emotion, composition, story moment, interaction, requested lighting); 2) fixed character info; 3) fixed scene info; 4) topic/context; 5) general cinematic enhancement.\nThe topic influences interpretation and style but must NEVER overwrite explicit user instructions.\nReplace @references in the user prompt with the actual retrieved descriptions in the final prompt.\n\nOUTPUT: Return ONLY a single valid JSON object, no markdown, no code fences, no commentary, with this shape:\n{\n  \"generation_type\": \"image\" | \"video\",\n  \"topic\": string,\n  \"original_prompt\": string,\n  \"characters\": [{ \"id\": string, \"name\": string, \"reference\": string, \"description\": string }],\n  \"scenes\": [{ \"id\": string, \"name\": string, \"reference\": string, \"description\": string }],\n  \"unresolved_references\": [{ \"reference\": string, \"status\": \"not_found\" }],\n  \"final_prompt\": string,\n  \"negative_prompt\": string,\n  \"visual_style\": string,\n  \"camera\": string,\n  \"lighting\": string,\n  \"composition\": string,\n  \"aspect_ratio\": string,\n  \"image\": { \"prompt\": string, \"negative_prompt\": string, \"aspect_ratio\": string },\n  \"video\": { \"prompt\": string, \"negative_prompt\": string, \"duration\": string, \"aspect_ratio\": string, \"camera_motion\": string, \"subject_motion\": string, \"environment_motion\": string }\n}\nfinal_prompt is the primary production-ready prompt. image.prompt and video.prompt must each be self-contained prompts usable directly by an image or video model.",
          "maxTokens": 4096
        }
      },
      "id": "87fbb8e2-6fb1-402e-be53-4b80493b2f73",
      "name": "Generate Structured Prompt",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
